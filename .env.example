# Copy this to .env.local for local development
# On Vercel, add these in Project Settings → Environment Variables

# Your Airtable API key (from airtable.com/account → Personal access tokens)
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Airtable base ID (already hardcoded in api/_airtable.js, but can override here)
AIRTABLE_BASE=app3uLCFgt3Y0aPaa

# Random secret for signing JWT tokens — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-random-secret-here-make-it-long-and-random
